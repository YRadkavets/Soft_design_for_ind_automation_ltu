        <Attribute Name="Configuration.Transaction.BezierPoints" Value="338.6671,247.4754,277.5573,312.6502" />
      </ECTransition>
      <ECTransition Source="CoolingDownFast" Destination="HeatingUp" Condition="REQ &amp; (HeatON &gt; 0)" x="2494.454" y="1165.53">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="591.369,257.8039,664.0204,307.2054" />
      </ECTransition>
      <ECTransition Source="CoolingDown" Destination="CoolingDownFast" Condition="REQ &amp; (HeatON &lt;= 0) &amp; ((InletFast &gt; 0) OR (InletSlow &gt; 0))" x="1464.316" y="1394.992">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="337.3747,383.1822,397.639,317.8402" />
      </ECTransition>
      <ECTransition Source="HeatingUp" Destination="HeatingUp" Condition="REQ &amp; (HeatON &gt; 0) &amp; NOT((WaterLevel&lt;50.0) &amp; (Temperature&gt;99.0))" x="2824.395" y="1941.712">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="780,506.25,633.75,510" />
      </ECTransition>
      <ECTransition Source="Overheat" Destination="Overheat" Condition="REQ &amp; (WaterLevel&lt;50.0 OR (HeatON &gt; 0))" x="4797.42" y="1065.58">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1292.5,261.25,1136.25,217.5" />
      </ECTransition>
      <ECTransition Source="HeatingUp" Destination="CoolingDown" Condition="REQ &amp; ((HeatON &lt;= 0) &amp; (InletFast &lt;=0) &amp; (InletSlow &lt;= 0))&#xD;&#xA;OR ((HeatON &gt; 0) &amp; (InletFast&gt;0.6) &amp; WaterLevel&lt;449.9 &amp; Temperature&gt;39.99)&#xD;&#xA;OR (( HeatON &gt;0) &amp; ( HeatPower &lt;0.1))&#xD;&#xA;" x="1838.409" y="1545.833">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="521.7757,360.993,388.7757,390.993" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST Text="Heat := 0.0;&#xD;&#xA;ResistON := FALSE;&#xD;&#xA;ResistBroken := FALSE;&#xD;&#xA;MaxTemp := 100.0;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="HeatUp" Comment="Normally executed algorithm">
      <ST Text="Heat := HeatON*HeatPower*(450.0/(WaterLevel+50));&#xD;&#xA;ResistON := TRUE;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="CoolDown">
      <ST Text="Heat := -15;&#xD;&#xA;MaxTemp := 100.0;&#xD;&#xA;ResistON := FALSE;&#xD;&#xA;ResistON := INT_TO_BOOL(REAL_TO_INT(HeatON));&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="Reset">
      <ST Text="Heat := 0.0;&#xD;&#xA;ResistON := FALSE;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="End">
      <ST Text="Overheating := FALSE;&#xD;&#xA;ResistON := FALSE;&#xD;&#xA;ResistBroken := TRUE;&#xD;&#xA;Heat := -15.0;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="Overheating">
      <ST Text="Heat := 100.0;&#xD;&#xA;MaxTemp := 200.0;&#xD;&#xA;ResistON := TRUE;&#xD;&#xA;Overheating := TRUE;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="ResistanceCooling">
      <ST Text="Heat := -30.0;&#xD;&#xA;ResistON := TRUE;&#xD;&#xA;Overheating := FALSE;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
    <Algorithm Name="CoolDownFast">
      <ST Text="Heat := -30.0;&#xD;&#xA;MaxTemp := 100.0;&#xD;&#xA;ResistON := FALSE;&#xD;&#xA;HP := HeatPower;" />
    </Algorithm>
  </BasicFB>
</FBType>