<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="36DE0A79D3A73E7B" Name="HeatCalc" Comment="Basic Function Block Type" Namespace="Main">
  <Attribute Name="Configuration.FB.IDCounter" Value="0" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="nxtControl GmbH" Version="0.0" Author="Andrei" Date="6/21/2016" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="HeatON" />
        <With Var="WaterLevel" />
        <With Var="InletFast" />
        <With Var="InletSlow" />
        <With Var="Temperature" />
        <With Var="HeatPower" />
      </Event>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="HeatON" />
        <With Var="WaterLevel" />
        <With Var="InletFast" />
        <With Var="InletSlow" />
        <With Var="Temperature" />
        <With Var="HeatPower" />
      </Event>
    </EventInputs>
    <EventOutputs>
