      </ECTransition>
      <ECTransition Source="Overheat" Destination="END" Condition="(Temperature&gt;199.9)" x="4842.635" y="1828.421">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1197.751,423.4355,1229.873,485.4286" />
      </ECTransition>
      <ECTransition Source="Overheat" Destination="ResistCooling" Condition="REQ AND ((HeatON &lt;= 0) OR (WaterLevel&gt;50.0))" x="3957.412" y="2103.816">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="1049.959,502.8124,954.5861,566.9073" />
      </ECTransition>
