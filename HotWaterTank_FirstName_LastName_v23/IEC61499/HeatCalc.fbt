        <With Var="ResistON" />
        <With Var="Heat" />
        <With Var="Overheating" />
        <With Var="ResistBroken" />
        <With Var="MaxTemp" />
        <With Var="HP" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="HeatON" Type="REAL" Comment="Input event qualifier" />
      <VarDeclaration Name="WaterLevel" Type="REAL" />
      <VarDeclaration Name="InletFast" Type="REAL" />
      <VarDeclaration Name="InletSlow" Type="REAL" />
      <VarDeclaration Name="Temperature" Type="REAL" />
      <VarDeclaration Name="HeatPower" Type="REAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ResistON" Type="BOOL" />
      <VarDeclaration Name="Heat" Type="REAL" Comment="Output event qualifier" />
      <VarDeclaration Name="Overheating" Type="BOOL" />
      <VarDeclaration Name="ResistBroken" Type="BOOL" />
      <VarDeclaration Name="MaxTemp" Type="REAL" />
      <VarDeclaration Name="HP" Type="REAL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,HeatUp,CoolDown,Reset,End,Overheating,ResistanceCooling,CoolDownFast" />
    <ECC>
