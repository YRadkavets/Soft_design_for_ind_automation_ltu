<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="9DFEC24361A440B5" Name="Heat_Control_Slider" Comment="Composite Function Block Type" Namespace="Main">
  <Attribute Name="Configuration.FB.IDCounter" Value="2" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="nxtControl GmbH" Version="0.0" Author="prana" Date="12/30/2019" Remarks="template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="Label" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm">
        <With Var="Temp_Value" />
      </Event>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="Temp_Value" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Label" Type="STRING" Comment="Input event qualifier" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Temp_Value" Type="REAL" InitialValue="40" Comment="Output event qualifier" />
    </OutputVars>
  </InterfaceList>
  <FBNetwork>
    <FB ID="1" Name="IThis1" Type="Heat_Control_Slider_HMI" x="1000" y="280" Namespace="Main">
      <Parameter Name="Heat_Value&gt;" Value="40" />
      <Parameter Name="QI" Value="TRUE" />
    </FB>
    <FB ID="2" Name="FB1" Type="E_SPLIT" x="580" y="280" Namespace="IEC61499.Standard" />
    <Input Name="INIT" x="120" y="292" Type="Event" />
    <Input Name="Label" x="20" y="592" Type="Data" />
    <Output Name="INITO" x="2000" y="252" Type="Event" />
    <Output Name="CNF" x="1940" y="392" Type="Event" />
    <Output Name="Temp_Value" x="1760" y="712" Type="Data" />
    <EventConnections>
      <Connection Source="INIT" Destination="FB1.EI" />
      <Connection Source="FB1.EO1" Destination="IThis1.INIT" />
      <Connection Source="FB1.EO2" Destination="IThis1.REQ" />
      <Connection Source="IThis1.INITO" Destination="INITO" dx1="40" />
      <Connection Source="IThis1.CNF" Destination="CNF" dx1="40" />
    </EventConnections>
    <DataConnections>
      <Connection Source="Label" Destination="IThis1.Label" dx1="40" />
      <Connection Source="IThis1.Heat_Value" Destination="Temp_Value" dx1="40" />
    </DataConnections>
  </FBNetwork>
</FBType>