      <VarDeclaration Name="X2" Type="REAL" />
      <VarDeclaration Name="Y2" Type="REAL" />
      <VarDeclaration Name="CurrentLevel" Type="REAL" />
      <VarDeclaration Name="CurrentTemp" Type="REAL" />
      <VarDeclaration Name="delta" Type="REAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="TargetLevel" Type="REAL" />
      <VarDeclaration Name="TargetTemp" Type="REAL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="Drain,pos1,pos2,pos3" />
