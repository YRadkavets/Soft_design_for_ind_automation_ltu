  <VersionInfo Organization="nxtControl GmBH" Version="0.0" Author="lizar" Date="10/11/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="START" Comment="Normal Execution Request">
        <With Var="X1" />
        <With Var="Y1" />
        <With Var="X2" />
        <With Var="Y2" />
        <With Var="delta" />
      </Event>
      <Event Name="STOP" />
      <Event Name="REQ">
