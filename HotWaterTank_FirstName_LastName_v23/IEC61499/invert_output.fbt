<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="13D8F6D254F9D8AB" Name="invert_output" Comment="Basic Function Block Type" Namespace="Main">
  <Attribute Name="Configuration.FB.IDCounter" Value="0" />
