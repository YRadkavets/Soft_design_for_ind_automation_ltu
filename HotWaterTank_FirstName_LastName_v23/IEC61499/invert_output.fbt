  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="920.9412" y="373.4117" />
      <ECState Name="INIT" Comment="Initialization" x="1399.53" y="793.1765">
        <ECAction Algorithm="INIT" Output="CNF" />
      </ECState>
      <ECState Name="REQ" Comment="Normal execution" x="245.647" y="872.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="REQ &amp; Neg" x="1249.223" y="538.4691">
