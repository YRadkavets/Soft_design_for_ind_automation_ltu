    <Input Name="INIT" x="340" y="252" Type="Event" />
    <Input Name="REQ" x="300" y="372" Type="Event" />
    <Input Name="Label" x="20" y="592" Type="Data" />
    <Output Name="INITO" x="2000" y="252" Type="Event" />
    <Output Name="CNF" x="1940" y="392" Type="Event" />
    <Output Name="Pump_OP" x="1760" y="711.8542" Type="Data" />
    <EventConnections>
